# BadZure Environment Variables
# Copy this file to .env and fill in your values
# The .env file is already in .gitignore and won't be committed

# Azure Tenant ID (GUID)
BADZURE_TENANT_ID=your-tenant-id-here

# Azure AD Domain (e.g., yourtenant.onmicrosoft.com)
BADZURE_DOMAIN=yourtenant.onmicrosoft.com

# Azure Subscription ID (GUID)
BADZURE_SUBSCRIPTION_ID=your-subscription-id-here

# ---------------------------------------------------------------------------
# LLM config — ONLY needed for `badzure generate` (LLM-authored org configs).
# Uses LiteLLM, so the model string selects the provider:
#   anthropic/claude-opus-4-1   openai/gpt-4o   gemini/gemini-1.5-pro
#   ollama/llama3 (local)       huggingface/<repo>
BADZURE_LLM_MODEL=anthropic/claude-opus-4-1
# Provider API key. LiteLLM ALSO honors native provider vars
# (ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY ...) if this is unset.
BADZURE_LLM_API_KEY=your-llm-api-key-here
# Optional: override the API base URL (local models / proxies / Azure OpenAI).
# BADZURE_LLM_BASE_URL=http://localhost:11434
